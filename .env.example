# Copy to .env and fill in the key(s) for the provider(s) you use.
# At least one of ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY is required.

# API key for Anthropic (Claude). Setting this alone picks the anthropic provider.
ANTHROPIC_API_KEY=

# API key for OpenAI. Setting this alone (with no ANTHROPIC_API_KEY) picks the openai provider.
OPENAI_API_KEY=

# API key for Google Gemini. Setting this alone (with no other key) picks the gemini provider.
GEMINI_API_KEY=

# Force a specific provider instead of auto-picking from whichever key is set above.
# One of: anthropic, openai, gemini
LLM_PROVIDER=

# Model override for the anthropic provider. Default: claude-sonnet-5
ANTHROPIC_MODEL=

# Model override for the openai provider. Default: gpt-5.6-terra
OPENAI_MODEL=

# Model override for the gemini provider. Default: gemini-3.7-flash
GEMINI_MODEL=

# Max output tokens per LLM call. Default: 16384
LLM_MAX_OUTPUT_TOKENS=

# Disk cache of LLM responses under ~/.cache/crawl/ (or $XDG_CACHE_HOME/crawl if
# set), keyed by provider+model+prompt.
# Set to 0 to disable caching. Default: 1 (enabled)
LLM_CACHE=
